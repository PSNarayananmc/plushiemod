{
  "format_version": "1.19.0",
  "animation_controllers": {
    "controller.animation.re_plushie_party.plushie_interaction": {
      "states": {
        "default": {
          "animations": ["idle"],
          "transitions": [{ "active": "query.variant == 0" }]
        },
        "active": {
          "animations": ["interact"],
          "transitions": [{ "default": "query.variant == 1" }]
        }
      }
    }
  }
}
